# =====================================================
# Copie este arquivo para .env.local e preencha
#   cp .env.example .env.local
# O .env.local NUNCA vai para o GitHub (está no .gitignore)
# =====================================================

# --- Supabase ---
# Onde achar: supabase.com > seu projeto > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ATENÇÃO: esta chave dá acesso total ao banco.
# Só use no servidor. Nunca em componente com "use client".
SUPABASE_SERVICE_ROLE_KEY=

# --- Contato ---
NEXT_PUBLIC_WHATSAPP=5500000000000
NEXT_PUBLIC_INSTAGRAM=camaleao3d
NEXT_PUBLIC_EMAIL=contato@camaleao3d.com.br

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Pagamento (preencher quando decidir) ---
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# --- Mercado Livre (futuro, deixar vazio por enquanto) ---
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
